// attrs.xml

<resources>
    <declare-styleable name="ProfileCard">
        <attr name="profileName" format="string"/>
        <attr name="profileImage" format="reference"/>
    </declare-styleable>
</resources>


// Custom View (ProfileCard.kt)

class ProfileCard @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null
) : LinearLayout(context, attrs) {

    init {
        LayoutInflater.from(context).inflate(R.layout.view_profile_card, this, true)

        val typedArray = context.obtainStyledAttributes(attrs, R.styleable.ProfileCard)
        val name = typedArray.getString(R.styleable.ProfileCard_profileName)
        val image = typedArray.getResourceId(R.styleable.ProfileCard_profileImage, 0)
        typedArray.recycle()

        findViewById<TextView>(R.id.profileName).text = name
        findViewById<ImageView>(R.id.profileImage).setImageResource(image)
    }
}


// Layout (view_profile_card.xml)

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/card_bg">

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="80dp"
        android:layout_height="80dp"/>

    <TextView
        android:id="@+id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"/>
</LinearLayout>


// Use in any layout

<com.example.myapp.ProfileCard
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:profileName="Ed Scoredman"
    app:profileImage="@drawable/avatar"/>